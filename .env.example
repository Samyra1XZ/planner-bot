BOT_TOKEN=your_telegram_bot_token_here
MY_CHAT_ID=your_telegram_chat_id_here

# Распознавание голоса. По умолчанию groq (облако, ничего не грузит на хост).
# Для локального Whisper поставь STT_PROVIDER=whisper (нужен ffmpeg + openai-whisper).
GROQ_API_KEY=your_groq_api_key_here
STT_PROVIDER=groq

# Путь к базе. Локально можно не трогать (будет reminders.db рядом со скриптом).
# На Railway: примонтируй Volume в /data и поставь DB_PATH=/data/reminders.db,
# иначе все будущие задачи и дни рождения пропадут при редеплое.
# DB_PATH=/data/reminders.db
